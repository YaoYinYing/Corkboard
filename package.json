{
  "name": "corkboard",
  "version": "0.0.0",
  "private": true,
  "description": "Shared, authenticated, durable message board for human and agent speakers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:contract": "node --test --test-reporter=spec \"tests/contract/**/*.test.ts\"",
    "test:security": "node --test --test-reporter=spec \"tests/security/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.ts",
    "check": "node --experimental-strip-types scripts/secret-scan.ts && node --experimental-strip-types scripts/history-secret-scan.ts && node --experimental-strip-types scripts/license-report.ts && tsc --noEmit && node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "audit": "node --experimental-strip-types scripts/npm-audit.ts",
    "licenses": "node scripts/license-report.ts",
    "sbom": "node scripts/sbom.ts",
    "secret-scan": "node scripts/secret-scan.ts",
    "secret-scan:history": "node scripts/history-secret-scan.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
